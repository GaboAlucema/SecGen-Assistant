# SecGen Assistant - Variables de Entorno

# URL de conexión al motor Edge AI (Ollama en el Nodo 2)
# Reemplazar por la IP estática del servidor HP
OLLAMA_URL=http://192.168.1.140:11434
MODEL_NAME=secgen-senior

# Puertos de los servicios
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Ajustes opcionales del backend (valores por defecto entre paréntesis)
# OLLAMA_TIMEOUT=900        # segundos máximos esperando al Nodo 2 (CPU: una auditoría puede tardar minutos)
# OLLAMA_KEEP_ALIVE=30m     # tiempo que el modelo queda cargado en memoria
# MAX_CODE_CHARS=15000      # máximo de caracteres de código por auditoría
# OLLAMA_WARMUP=1           # 1 = precalienta el modelo al arrancar y lo mantiene caliente (evita ~60 s de arranque en frío)
# OLLAMA_WARMUP_INTERVAL=1200  # segundos entre precalentamientos (debe ser menor que OLLAMA_KEEP_ALIVE)
# NEXT_PUBLIC_API_URL=      # vacío = el navegador usa <host del front>:BACKEND_PORT

# Servidor Nodo 1
NODE1IP=
NODE1User=
NODE1Pass=

# Servidor Nodo 2
NODE2IP=
NODE2User=
NODE2Pass=